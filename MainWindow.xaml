<Window x:Class="smartClass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="SmartClass"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Height="70">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources RequestedTheme="{x:Null}"/>
                <ui:XamlControlsResources/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 顶栏背景：自上而下从深色渐变到透明 -->
    <Border CornerRadius="0">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#E6101018" Offset="0"/>
                <GradientStop Color="#E6101018" Offset="0.55"/>
                <GradientStop Color="#C8101018" Offset="0.75"/>
                <GradientStop Color="#00101018" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== 左栏 ========== -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- 日期 + 星期 -->
                <TextBlock Name="DateLabel" VerticalAlignment="Center"
                           Foreground="#e0e0e8" FontSize="24" FontWeight="SemiBold"
                           Text="6月26日 周五"/>

                <!-- 分割线 -->
                <Border Width="1" Height="40" Margin="20,0"
                        Background="#1effffff"/>

                <!-- 倒计时 -->
                <TextBlock Name="CountdownLabel" VerticalAlignment="Center"
                           Foreground="#f0a040" FontSize="18"
                           Text="距期末 0 天"/>

            </StackPanel>

            <!-- ========== 中栏 ========== -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Name="ClockLabel"
                           Foreground="#f0f0f8" FontSize="24" FontWeight="Light"
                           FontFamily="Consolas" Cursor="Hand"
                           ToolTip="点击进入全屏时钟"
                           Text="00:00:00"/>
            </StackPanel>

            <!-- ========== 右栏 ========== -->
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">

                <!-- 课程信息 -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Name="NextCourseLabel"
                               Foreground="#7ec8e3" FontSize="20" FontWeight="SemiBold"
                               TextAlignment="Right"
                               Text="下一节"/>
                    <TextBlock Name="Next2CourseLabel"
                               Foreground="#8888a0" FontSize="15"
                               TextAlignment="Right"
                               Text=""/>
                </StackPanel>


            </StackPanel>
        </Grid>
    </Border>
</Window>
