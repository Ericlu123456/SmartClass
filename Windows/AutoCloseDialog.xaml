<Window x:Class="smartClass.Windows.AutoCloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="询问" Height="150" Width="350" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Name="MessageText" TextWrapping="Wrap" FontSize="14"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Name="YesBtn" Content="是" Width="80" Margin="10,0"/>
            <Button Name="NoBtn" Content="否" Width="80" Margin="10,0"/>
        </StackPanel>
    </Grid>
</Window>
