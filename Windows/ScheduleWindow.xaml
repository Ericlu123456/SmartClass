<Window x:Class="smartClass.Windows.ScheduleWindow"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     Title="今日课程与值日"
     SizeToContent="WidthAndHeight"
     WindowStyle="None"
     AllowsTransparency="True"
     Background="Transparent"
     Topmost="True"
     ShowInTaskbar="False">


<Border x:Name="MainBorder"
        Background="#DDFFFFFF"
        BorderBrush="#404040"
        BorderThickness="1"
        CornerRadius="6"
        Padding="8">

    <StackPanel Orientation="Horizontal">

        <StackPanel Width="350">
            <TextBlock Text="今日课程"
                       FontWeight="Bold"/>

            <ListBox Name="CoursesList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Subject}"
                                       Width="180"
                                       FontSize="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=FontSize}"/>

                            <TextBlock Text="{Binding StartTime}"
                                       Width="80"
                                       FontSize="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=FontSize}"/>

                            <TextBlock Text="-"
                                       Width="10"
                                       FontSize="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=FontSize}"/>

                            <TextBlock Text="{Binding EndTime}"
                                       Width="80"
                                       FontSize="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=FontSize}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <StackPanel Width="280" Margin="10,0,0,0">
            <TextBlock Text="今日值日"
                       FontWeight="Bold"/>

            <ListBox Name="DutyList"
                     MinWidth="200"
                     BorderThickness="0"
                     Background="Transparent">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}"
                                       Width="140"/>

                            <TextBlock Text=" ("
                                       Foreground="#666"/>

                            <TextBlock Text="{Binding Role}"
                                       Foreground="#666"/>

                            <TextBlock Text=")"
                                       Foreground="#666"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </StackPanel>

    </StackPanel>

</Border>


</Window>
