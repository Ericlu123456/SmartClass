<Window x:Class="smartClass.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="600" Width="1000">
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Name="border">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E8E8E8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D0D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButtonSelectedStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Background="#F3F3F3" Margin="10">
            <CheckBox Name="RunOnStartupChk" Content="开机自启动" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="字体大小:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBox Name="FontSizeBox" Width="60" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Name="ImportConfigBtn" Content="导入配置" Width="90" Margin="0,0,10,0"/>
            <Button Name="ExportConfigBtn" Content="导出配置" Width="90" Margin="0,0,10,0"/>
            <Button Name="SaveBtn" Content="保存" Width="100" Margin="0,0,10,0"/>
            <Button Name="CloseBtn" Content="关闭" Width="100"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Vertical Navigation Pane -->
            <Border Grid.Column="0" Background="#F6F6F6" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="NavigationPane">
                        <Button Name="NavStudentsBtn" Content="👥 学生" Style="{StaticResource NavButtonStyle}" Click="NavStudentsBtn_Click"/>
                        <Button Name="NavCoursesBtn" Content="📚 课程" Style="{StaticResource NavButtonStyle}" Click="NavCoursesBtn_Click"/>
                        <Button Name="NavGroupsBtn" Content="👨‍👩‍👧‍👦 值日组" Style="{StaticResource NavButtonStyle}" Click="NavGroupsBtn_Click"/>
                        <Button Name="NavDutyBtn" Content="📅 每日值日" Style="{StaticResource NavButtonStyle}" Click="NavDutyBtn_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Content Area with ScrollViewer -->
            <ScrollViewer Grid.Column="1">
                <StackPanel Name="ContentArea" Margin="10">

                    <!-- Students Page -->
                    <Grid Name="StudentsPage" Visibility="Visible" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="学生列表" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <ListBox Name="StudentsList" Height="300" DisplayMemberPath="Name"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Name="AddStudentBtn" Content="添加学生" Width="100" Margin="0,0,10,0"/>
                                <Button Name="RemoveStudentBtn" Content="移除选中" Width="100"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="学生详情" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="学号:" Width="80"/>
                                <TextBox Name="StudentIdBox" IsReadOnly="True" Width="220"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="姓名:" Width="80"/>
                                <TextBox Name="StudentNameBox" Width="220"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="社评值:" Width="80"/>
                                <TextBox Name="StudentCreditsBox" Width="80"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Name="ApplyStudentBtn" Content="应用更改" Width="100" Margin="0,0,10,0"/>
                                <Button Name="ResetStudentBtn" Content="重置" Width="100"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Courses Page -->
                    <Grid Name="CoursesPage" Visibility="Collapsed" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="课程列表" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <ListBox Name="CoursesList" Height="300" DisplayMemberPath="Subject"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Name="AddCourseBtn" Content="添加课程" Width="100" Margin="0,0,10,0"/>
                                <Button Name="RemoveCourseBtn" Content="移除选中" Width="100"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="课程详情" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="科目:" Width="80"/>
                                <TextBox Name="CourseSubjectBox" Width="220"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="星期:" Width="80"/>
                                <ComboBox Name="CourseDayBox" Width="120">
                                    <ComboBoxItem>周一</ComboBoxItem>
                                    <ComboBoxItem>周二</ComboBoxItem>
                                    <ComboBoxItem>周三</ComboBoxItem>
                                    <ComboBoxItem>周四</ComboBoxItem>
                                    <ComboBoxItem>周五</ComboBoxItem>
                                    <ComboBoxItem>周六</ComboBoxItem>
                                    <ComboBoxItem>周日</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="开始 (HH:mm):" Width="80"/>
                                <TextBox Name="CourseStartBox" Width="120"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="结束 (HH:mm):" Width="80"/>
                                <TextBox Name="CourseEndBox" Width="120"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Name="ApplyCourseBtn" Content="应用更改" Width="100" Margin="0,0,10,0"/>
                                <Button Name="ResetCourseBtn" Content="重置" Width="100"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Groups Page -->
                    <Grid Name="GroupsPage" Visibility="Collapsed" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="值日组列表" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <ListBox Name="DutyGroupsList" Height="300" DisplayMemberPath="Name"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Name="AddGroupBtn" Content="添加组" Width="100" Margin="0,0,10,0"/>
                                <Button Name="RemoveGroupBtn" Content="移除选中" Width="100"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="值日组详情" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="组名:" Width="80"/>
                                <TextBox Name="GroupNameBox" Width="220"/>
                            </StackPanel>

                            <TextBlock Text="组成员:" Margin="0,12,0,8" FontWeight="Bold"/>
                            <ListBox Name="GroupMembersList" Height="120"/>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ComboBox Name="AddMemberStudentBox" Width="160" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                <TextBox Name="AddMemberRoleBox" Width="120" Margin="8,0,0,0"/>
                                <Button Name="AddMemberBtn" Content="添加成员" Width="80" Margin="8,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Name="RemoveMemberBtn" Content="移除选中成员" Width="140"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Name="ApplyGroupBtn" Content="应用更改" Width="100" Margin="0,0,10,0"/>
                                <Button Name="ResetGroupBtn" Content="重置" Width="100"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Duty Page -->
                    <Grid Name="DutyPage" Visibility="Collapsed" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="日期选择" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <Calendar Name="DutyCalendar" Height="280"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ComboBox Name="DutyGroupAssignBox" Width="140" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                <Button Name="AssignDutyBtn" Content="指派" Width="80" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="已排值日" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <ListBox Name="AssignedDutiesList" Height="300" DisplayMemberPath="Date"/>
                            <Button Name="RemoveAssignedDutyBtn" Content="移除选中" Width="120" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
