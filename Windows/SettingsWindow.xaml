<Window x:Class="smartClass.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.Height="36"
        Title="设置" Height="600" Width="1000">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources RequestedTheme="{x:Null}"/>
                <ui:XamlControlsResources/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Name="border">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavButtonSelectedStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Name="ImportConfigBtn" Content="导入配置" Width="90" Margin="0,0,10,0"/>
            <Button Name="ExportConfigBtn" Content="导出配置" Width="90" Margin="0,0,10,0"/>
            <Button Name="CloseBtn" Content="关闭" Width="100"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Vertical Navigation Pane -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="NavigationPane">
                        <Button Name="NavGeneralBtn" Content="⚙ 常规" Style="{StaticResource NavButtonStyle}"/>
                        <Button Name="NavStudentsBtn" Content="👥 学生" Style="{StaticResource NavButtonStyle}"/>
                        <Button Name="NavCoursesBtn" Content="📚 课程" Style="{StaticResource NavButtonStyle}"/>
                        <Button Name="NavGroupsBtn" Content="👨‍👩‍👧‍👦 值日组" Style="{StaticResource NavButtonStyle}"/>
                        <Button Name="NavDutyBtn" Content="📅 每日值日" Style="{StaticResource NavButtonStyle}"/>
                        <Button Name="NavAboutBtn" Content="ℹ 关于" Style="{StaticResource NavButtonStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Content Area with ScrollViewer -->
            <ScrollViewer Grid.Column="1">
                <StackPanel Name="ContentArea" Margin="10">

                    <!-- General Page -->
                    <Grid Name="GeneralPage" Visibility="Visible" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="常规" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock Text="字体大小:" Width="80" VerticalAlignment="Center"/>
                                <TextBox Name="FontSizeBox" Width="60" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock Text="开机自启动:" Width="80" VerticalAlignment="Center"/>
                                <CheckBox Name="RunOnStartupChk" Content="启用" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock Text="自动关机:" Width="80" VerticalAlignment="Center"/>
                                <CheckBox Name="EnableShutdownChk" Content="启用每天定时关机" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock Text="关机时间 (HH:mm):" Width="120" VerticalAlignment="Center"/>
                                <TextBox Name="AutoShutdownTimeBox" Width="80" VerticalAlignment="Center"/>
                                <TextBlock Text=" (24小时制)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#666"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock Text="语音播报:" Width="80" VerticalAlignment="Center"/>
                                <CheckBox Name="EnableSpeechChk" Content="启用上下课语音提醒" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                                <TextBlock Text="学期结束:" Width="80" VerticalAlignment="Center"/>
                                <DatePicker Name="SemesterEndPicker" Width="160" VerticalAlignment="Center"/>
                            </StackPanel>

                        </StackPanel>
                    </Grid>

                    <!-- Students Page -->
                    <Grid Name="StudentsPage" Visibility="Collapsed" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="学生列表" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <ListBox Name="StudentsList" Height="300" DisplayMemberPath="Name"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Name="AddStudentBtn" Content="添加学生" Width="100" Margin="0,0,10,0"/>
                                <Button Name="RemoveStudentBtn" Content="移除选中" Width="100"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="学生详情" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="学号:" Width="80"/>
                                <TextBox Name="StudentIdBox" IsReadOnly="True" Width="220"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="姓名:" Width="80"/>
                                <TextBox Name="StudentNameBox" Width="220"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="社评值:" Width="80"/>
                                <TextBox Name="StudentCreditsBox" Width="80"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Name="ApplyStudentBtn" Content="应用更改" Width="100" Margin="0,0,10,0"/>
                                <Button Name="ResetStudentBtn" Content="重置" Width="100"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Courses Page -->
                    <Grid Name="CoursesPage" Visibility="Collapsed" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="350"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Weekly Course View -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="课程表" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                <Button Name="AddCourseBtn" Content="+ 添加课程" Margin="10,0,0,0" Padding="8,4" Width="120"/>
                            </StackPanel>

                            <!-- Scrollable tab control for each day -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="400">
                                <StackPanel Name="CoursesSchedulePanel">
                                    <!-- Day 1: 周一 -->
                                    <Expander Header="📍 周一" IsExpanded="True" Margin="0,0,0,8">
                                        <ListBox Name="MondayList" Height="120" SelectionChanged="CoursesList_SelectionChanged" Margin="0,8,0,0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="8" CornerRadius="4" Margin="0,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Subject}" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding StartTime, StringFormat=开始时间: {0}}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding EndTime, StringFormat=结束时间: {0}}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="×" Width="24" Height="24" Padding="0" VerticalAlignment="Top" Name="RemoveCourseBtn" Click="RemoveCourseBtn_Click" Tag="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>

                                    <!-- Day 2: 周二 -->
                                    <Expander Header="📍 周二" Margin="0,0,0,8">
                                        <ListBox Name="TuesdayList" Height="120" SelectionChanged="CoursesList_SelectionChanged" Margin="0,8,0,0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="8" CornerRadius="4" Margin="0,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Subject}" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding StartTime, StringFormat=开始时间: {0}}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding EndTime, StringFormat=结束时间: {0}}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="×" Width="24" Height="24" Padding="0" VerticalAlignment="Top" Click="RemoveCourseBtn_Click" Tag="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>

                                    <!-- Day 3: 周三 -->
                                    <Expander Header="📍 周三" Margin="0,0,0,8">
                                        <ListBox Name="WednesdayList" Height="120" SelectionChanged="CoursesList_SelectionChanged" Margin="0,8,0,0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="8" CornerRadius="4" Margin="0,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Subject}" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding StartTime, StringFormat=开始时间: {0}}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding EndTime, StringFormat=结束时间: {0}}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="×" Width="24" Height="24" Padding="0" VerticalAlignment="Top" Click="RemoveCourseBtn_Click" Tag="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>

                                    <!-- Day 4: 周四 -->
                                    <Expander Header="📍 周四" Margin="0,0,0,8">
                                        <ListBox Name="ThursdayList" Height="120" SelectionChanged="CoursesList_SelectionChanged" Margin="0,8,0,0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="8" CornerRadius="4" Margin="0,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Subject}" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding StartTime, StringFormat=开始时间: {0}}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding EndTime, StringFormat=结束时间: {0}}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="×" Width="24" Height="24" Padding="0" VerticalAlignment="Top" Click="RemoveCourseBtn_Click" Tag="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>

                                    <!-- Day 5: 周五 -->
                                    <Expander Header="📍 周五" Margin="0,0,0,8">
                                        <ListBox Name="FridayList" Height="120" SelectionChanged="CoursesList_SelectionChanged" Margin="0,8,0,0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="8" CornerRadius="4" Margin="0,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Subject}" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding StartTime, StringFormat=开始时间: {0}}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding EndTime, StringFormat=结束时间: {0}}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="×" Width="24" Height="24" Padding="0" VerticalAlignment="Top" Click="RemoveCourseBtn_Click" Tag="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>

                                    <!-- Day 6: 周六 -->
                                    <Expander Header="📍 周六" Margin="0,0,0,8">
                                        <ListBox Name="SaturdayList" Height="120" SelectionChanged="CoursesList_SelectionChanged" Margin="0,8,0,0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="8" CornerRadius="4" Margin="0,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Subject}" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding StartTime, StringFormat=开始时间: {0}}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding EndTime, StringFormat=结束时间: {0}}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="×" Width="24" Height="24" Padding="0" VerticalAlignment="Top" Click="RemoveCourseBtn_Click" Tag="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>

                                    <!-- Day 7: 周日 -->
                                    <Expander Header="📍 周日" Margin="0,0,0,8">
                                        <ListBox Name="SundayList" Height="120" SelectionChanged="CoursesList_SelectionChanged" Margin="0,8,0,0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="8" CornerRadius="4" Margin="0,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Subject}" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding StartTime, StringFormat=开始时间: {0}}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding EndTime, StringFormat=结束时间: {0}}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="×" Width="24" Height="24" Padding="0" VerticalAlignment="Top" Click="RemoveCourseBtn_Click" Tag="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Right: Course Details Edit Panel -->
                        <StackPanel Grid.Column="1" Margin="15,0,0,0">
                            <TextBlock Text="课程详情" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Text="(选择课程进行编辑)" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,15"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="科目:" Width="60" VerticalAlignment="Center"/>
                                <TextBox Name="CourseSubjectBox" Width="250"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="星期:" Width="60" VerticalAlignment="Center"/>
                                <ComboBox Name="CourseDayBox" Width="120">
                                    <ComboBoxItem>周一</ComboBoxItem>
                                    <ComboBoxItem>周二</ComboBoxItem>
                                    <ComboBoxItem>周三</ComboBoxItem>
                                    <ComboBoxItem>周四</ComboBoxItem>
                                    <ComboBoxItem>周五</ComboBoxItem>
                                    <ComboBoxItem>周六</ComboBoxItem>
                                    <ComboBoxItem>周日</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="开始:" Width="60" VerticalAlignment="Center"/>
                                <TextBox Name="CourseStartBox" Width="120"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="结束:" Width="60" VerticalAlignment="Center"/>
                                <TextBox Name="CourseEndBox" Width="120"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Name="ApplyCourseBtn" Content="应用更改" Width="100" Margin="0,0,10,0"/>
                                <Button Name="ResetCourseBtn" Content="重置" Width="100"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Groups Page -->
                    <Grid Name="GroupsPage" Visibility="Collapsed" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="值日组列表" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <ListBox Name="DutyGroupsList" Height="300" DisplayMemberPath="Name"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Name="AddGroupBtn" Content="添加组" Width="100" Margin="0,0,10,0"/>
                                <Button Name="RemoveGroupBtn" Content="移除选中" Width="100"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="值日组详情" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="组名:" Width="80"/>
                                <TextBox Name="GroupNameBox" Width="220"/>
                            </StackPanel>

                            <TextBlock Text="组成员:" Margin="0,12,0,8" FontWeight="Bold"/>
                            <ListBox Name="GroupMembersList" Height="120"/>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ComboBox Name="AddMemberStudentBox" Width="160" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                <TextBox Name="AddMemberRoleBox" Width="120" Margin="8,0,0,0"/>
                                <Button Name="AddMemberBtn" Content="添加成员" Width="80" Margin="8,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Name="RemoveMemberBtn" Content="移除选中成员" Width="140"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Name="ApplyGroupBtn" Content="应用更改" Width="100" Margin="0,0,10,0"/>
                                <Button Name="ResetGroupBtn" Content="重置" Width="100"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Duty Page -->
                    <Grid Name="DutyPage" Visibility="Collapsed" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="日期选择" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <Calendar Name="DutyCalendar" Height="280"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ComboBox Name="DutyGroupAssignBox" Width="140" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                <Button Name="AssignDutyBtn" Content="指派" Width="80" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="已排值日" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <ListBox Name="AssignedDutiesList" Height="300" DisplayMemberPath="Date"/>
                            <Button Name="RemoveAssignedDutyBtn" Content="移除选中" Width="120" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- About Page -->
                    <Grid Name="AboutPage" Visibility="Collapsed" Margin="0,0,0,20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- 点击标题7次触发开发者选项 -->
                            <TextBlock Name="AboutTitle" Text="智能教室系统" FontSize="28" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,10" Cursor="Hand"/>
                            <TextBlock Text="Made with love by 雨夜漫步" FontSize="20" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20"/>
                            <TextBlock Text="版本 1.1" FontSize="14" TextAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="" FontSize="12" TextAlignment="Center" Margin="0,20,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" MaxWidth="400">
                                <Run Text="你的老师是不是经常拖堂？"/>
                                <LineBreak/>
                                <Run Text="你的学生是不是天天不做值日？"/>
                                <LineBreak/>
                                <Run Text="这就是你的解决方案。"/>
                            </TextBlock>

                            <!-- 开发者选项面板（默认隐藏） -->
                            <Border Name="DevPanel" Visibility="Collapsed" Margin="0,20,0,0" Padding="16"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="8" MaxWidth="350">
                                <StackPanel>
                                    <TextBlock Text="🔧 开发者选项" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <Button Name="DevTestNotifyBtn" Content="🔔 测试通知" Margin="0,4" Height="36"/>
                                    <Button Name="DevTestDialogBtn" Content="💬 测试对话框" Margin="0,4" Height="36"/>
                                    <Button Name="DevTestSpeechBtn" Content="🔊 测试语音播报" Margin="0,4" Height="36"/>
                                    <Button Name="DevViewLogBtn" Content="📄 查看日志" Margin="0,4" Height="36"/>
